@page
@model APIServerMFE_DeLonghi.Pages.MissionsModel
@{
    ViewData["Title"] = "Avvio Missioni";
}

<h2>Missioni MiR</h2>

<p>Seleziona il tempo di attesa (TimeToWait): <span id="timeDisplay">@Model.TimeToWait</span></p>

<button type="button" id="incrementBtn">Incrementa 1s</button>
<button type="button" id="decrementBtn">Decrementa 1s</button>

<form method="post" asp-page-handler="Serial Order Wait">
    <input type="hidden" name="TimeToWait" id="timeInput" value="@Model.TimeToWait" />
    <button type="submit">Avvia Missione 1</button>
</form>

@* <form method="post" asp-page-handler="Mission2">
    <button type="submit">Avvia Missione 2</button>
</form> *@

<p>@Model.Message</p>

<script>
    // inizializza il contatore
    let counter = 2; // valore iniziale in secondi
    const display = document.getElementById("timeDisplay");
    const input1 = document.getElementById("timeInput1");
    // const input2 = document.getElementById("timeInput2");

    function updateDisplay() {
        let formattedTime = "00.00." + counter.toString().padStart(2, '0');
        display.textContent = formattedTime;
        input1.value = formattedTime;
        // input2.value = formattedTime;
    }

    document.getElementById("incrementBtn").addEventListener("click", function () {
        counter += 1;
        updateDisplay();
    });

    document.getElementById("decrementBtn").addEventListener("click", function () {
        if (counter > 1) counter -= 1;
        updateDisplay();
    });

</script>