@page
@model APIServerMFE_DeLonghi.Pages.SerialOrderWaitWithParametersModel
@{
    ViewData["Title"] = "Serial Order Wait With Parameters";
}

<h3>Serial Order Wait with Parameters</h3>

<p><b>Seleziona il tempo di attesa (TimeToWait): </b><span id="timeDisplay">@Model.TimeToWait</span></p>

<div class="btn-group mb-3">
    <p><button type="button" id="incrementBtn">Incrementa 1s</button>
    <button type="button" id="decrementBtn">Decrementa 1s</button></p>
</div>  

<div>
