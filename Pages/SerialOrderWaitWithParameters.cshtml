                <label for="Code15">Cod HU 15:</label>
                <input type="text" name="CodesHU[14]" value="@Model.CodesHU.ElementAtOrDefault(14)" size="1 maxlength="1" value="3" placeholder="" /></br/></br/>
                <label for="Code16">Cod HU 16:</label>
                <input type="text" name="CodesHU[15]" value="@Model.CodesHU.ElementAtOrDefault(15)" size="1" maxlength="1" value="6" placeholder="" /></br/></br/>
                <label for="Code17">Cod HU 17:</label>
                <input type="text" name="CodesHU[16]" value="@Model.CodesHU.ElementAtOrDefault(16)" size="1" maxlength="1" value="0" placeholder="" /></br/></br/>
                <label for="Code18">Cod HU 18:</label>
                <input type="text" name="CodesHU[17]" value="@Model.CodesHU.ElementAtOrDefault(17)" size="1 maxlength="1" value="7" placeholder="" /></br/></br/>
