                <input type="text" name="CodesHU[3]" value="@Model.CodesHU.ElementAtOrDefault(3)" size="1 maxlength="1" value="7" placeholder="" /></br/></br/>
                <label for="Code5">Cod HU 05:</label>
                <input type="text" name="CodesHU[4]" value="@Model.CodesHU.ElementAtOrDefault(4)" size="1 maxlength="1" value="8" placeholder="" /></br/></br/>
                <label for="Code6">Cod HU 06:</label>
                <input type="text" name="CodesHU[5]" value="@Model.CodesHU.ElementAtOrDefault(5)" size="1" maxlength="1" value="0" placeholder="" /></br/></br/>
                <label for="Code7">Cod HU 07:</label>
                <input type="text" name="CodesHU[6]" value="@Model.CodesHU.ElementAtOrDefault(6)" size="1" maxlength="1" value="0" placeholder="" /></br/></br/>
                <label for="Code8">Cod HU 08:</label>
                <input type="text" name="CodesHU[7]" value="@Model.CodesHU.ElementAtOrDefault(7)" size="1 maxlength="1" value="4" placeholder="" /></br/></br/>
                <label for=" Code9">Cod HU 09:</label>
                <input type="text" name="CodesHU[8]" value="@Model.CodesHU.ElementAtOrDefault(8)" size="1" maxlength="1" value="3" placeholder="" /></br/></br/>
                <label for=" Code10">Cod HU 10:</label>
                <input type="text" name="CodesHU[9]" value="@Model.CodesHU.ElementAtOrDefault(9)" size="1 maxlength="1" value="9" placeholder="" /></br/></br/>
          </div>
      </td>
      <td width ="30"></td>
      <td>
            <div class="mb-3">
                <br /><br />
                <label for="Code11">Cod HU 11:</label>
                <input type="text" name="CodesHU[10]" value="@Model.CodesHU.ElementAtOrDefault(10)" size="1 maxlength="1" value="0" placeholder="" /></br/></br/>
                <label for="Code12">Cod HU 12:</label>
                <input type="text" name="CodesHU[11]" value="@Model.CodesHU.ElementAtOrDefault(11)" size="1" maxlength="1" value="0" placeholder="" /></br/></br/>
