 </p>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="text-success mt-3">@Model.Message</p>
}

<div>
    <a asp-page="/Index">Home</a>
</div>


<script>
    // inizializza il contatore
    let counter = @Model.TimeToWait;
    const display = document.getElementById("timeDisplay");
    const input1 = document.getElementById("timeInput");

    function updateDisplay() {
        display.textContent = counter;
        input1.value = counter;
    }

    document.getElementById("incrementBtn").addEventListener("click", function () {
        counter += 1;
        updateDisplay();
    });

    document.getElementById("decrementBtn").addEventListener("click", function () {
        if (counter > 1) counter -= 1;
        updateDisplay();
    });

    updateDisplay(); // inizializza il display al caricamento

    document.getElementById("resetBtn").addEventListener("click", function () {
        const inputs = document.querySelectorAll('input[name^="CodesHU"]');
        inputs.forEach(input => input.value = "€");
    });


</script>
